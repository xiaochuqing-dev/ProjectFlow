# ProjectFlow environment template
# Copy this file to .env and fill local values. Do not commit real secrets.

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Backend
APP_ENV=local
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=projectflow
POSTGRES_USER=projectflow
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=jdbc:postgresql://localhost:5432/projectflow
DATABASE_USERNAME=projectflow
DATABASE_PASSWORD=change-me-local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=60

# AI provider
# V1 starts with mock mode. Set AI_PROVIDER=deepseek or openai-compatible later.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional bounded project-understanding limits
PROJECTFLOW_UNDERSTANDING_MAX_FILES=250000
PROJECTFLOW_UNDERSTANDING_MAX_FILE_DETAILS=5000
PROJECTFLOW_UNDERSTANDING_MAX_SOURCE_SAMPLE_BYTES=65536
PROJECTFLOW_UNDERSTANDING_MAX_SOURCE_CONTENT_SAMPLES=1500
PROJECTFLOW_UNDERSTANDING_MAX_PROMPT_CHARS=48000
PROJECTFLOW_UNDERSTANDING_MAX_EVIDENCE_CANDIDATES=500
PROJECTFLOW_UNDERSTANDING_MAX_SCOUT_EVIDENCE=80
