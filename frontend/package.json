{
  "name": "projectflow-frontend",
  "version": "3.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('node:fs').rmSync('.next/dev', { recursive: true, force: true })\"",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:contracts": "node --test tests/*.test.mjs",
