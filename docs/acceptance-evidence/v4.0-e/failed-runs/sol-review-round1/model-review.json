  "issues": [
    {
      "id": "CA-SOL-001",
      "severity": "MAJOR",
      "title": "默认八条变化主要是文件分类，且同一提交被拆成多个并列 Story",
      "finding": "八条变化中，文档新增/修改、前端、后端、沟通/备份/存储等记录大量重叠。前五条详情显示 Story 2、3、4 的首个 Evidence 使用同一 commit 6a0fed928c64f8fea85872bc1e927886c2f948e6，但页面把它们作为三条相邻的“最近变化”，没有说明它们属于同一开发批次或共同形成的结果。",
      "impact": "首次使用者会把一个提交中的不同文件区域误读为多个独立成果，也无法回答最近真正完成或推进了什么。",
      "locations": [
        "visible-text/corporation-history-default-final.txt:56-109",
        "visible-text/corporation-story-2-evidence-final.txt:32-50",
        "visible-text/corporation-story-3-evidence-final.txt:32-50",
        "visible-text/corporation-story-4-evidence-final.txt:32-50",
        "screenshots/corporation-history-default-final-1.png",
        "screenshots/corporation-history-default-final-2.png"
      ],
      "revisionNeeded": "把同一开发批次的重叠文件分类收束为一个主 Story，或明确标成同一 Story 的子范围；标题应描述证据能支持的具体结果，不能只枚举目录或文件类型。"
    },
    {
      "id": "CA-SOL-002",
      "severity": "MAJOR",
      "title": "长期主题不是可识别的功能、问题或方向",
      "finding": "主题目录包含“一次提交的代码与配套文件”“任务01报告”“任务01报告（版本1）”“相关代码（含工作区、报告、对话文件）”等制品名或文件集合，多数只有一条关联变化；首个主题详情仅复述一条 Story，并仍然没有目的或演变。",
      "impact": "“按长期主题查看”无法帮助用户追踪一个能力或问题如何跨阶段变化，反而增加 Story、Chapter、Thread 三层重复。",
