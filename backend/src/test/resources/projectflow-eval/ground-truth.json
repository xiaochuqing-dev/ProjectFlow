    {
      "id": "short-git-history",
      "source": "fixture://short-git-history",
      "important": false,
      "context": "source:git-meta 显示 3 个最近提交、无 Tag、无 Fact；只能说明历史很短。",
      "expectedProjectShapes": ["CODE_PROJECT"],
      "mustFindEvidence": ["source:git-meta"],
      "mustNotClaim": ["mature lifecycle", "multiple development phases", "release"],
