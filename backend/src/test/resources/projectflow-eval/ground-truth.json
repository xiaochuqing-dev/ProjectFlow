    {
      "id": "stale-readme",
      "source": "fixture://stale-readme",
      "important": true,
      "context": "source:readme 声称当前版本 1.0，但 source:manifest 显示 2.0；README 标记 POSSIBLY_STALE。",
      "toolEvidence": "source:readme 深读仍写 current version 1.0，且没有更新时间；同一项目 source:manifest 的规范化当前版本为 2.0。两者冲突，README 当前性不能确认。",
      "expectedProjectShapes": ["CODE_PROJECT"],
      "mustFindEvidence": ["source:readme", "source:manifest"],
      "mustNotClaim": ["current version is 1.0"],
      "expectedTools": ["DOC_READER", "MANIFEST"],
      "forbiddenTools": [],
      "expectedViews": ["CURRENT_STATE", "LIMITATIONS"],
      "forbiddenViews": [],
      "expectedUnknowns": ["README update date"],
      "expectedConflicts": ["README_CURRENTNESS"],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": ["source:readme"]
    },
    {
      "id": "readme-source-conflict",
      "source": "fixture://readme-source-conflict",
      "important": true,
      "context": "source:readme 宣称已实现本地数据库，source:manifest 与 source:code 明确没有数据库依赖或实现。",
      "toolEvidence": "source:readme 深读写有 built-in local database；source:manifest 的依赖清单无数据库 driver，source:code 的有界结构证据也没有 repository/schema。该冲突不能证明数据库已实现，也不能判断 README 描述的是旧功能还是未来计划。",
      "expectedProjectShapes": ["CODE_PROJECT"],
      "mustFindEvidence": ["source:readme", "source:manifest", "source:code"],
      "mustNotClaim": ["local database is implemented"],
      "expectedTools": ["DOC_READER", "MANIFEST"],
      "forbiddenTools": [],
      "expectedViews": ["CURRENT_STATE", "CONFLICTS"],
      "forbiddenViews": ["DATABASE"],
      "expectedUnknowns": ["whether README describes removed or future work"],
      "expectedConflicts": ["README_SOURCE_CONFLICT"],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": ["source:readme"]
    },
    {
      "id": "agent-result",
      "source": "fixture://agent-result",
      "important": true,
      "context": "source:agent-result 是一次 Agent result，报告测试成功，但尚未经过 ProjectFact 证据链校验。",
      "toolEvidence": "source:agent-result 深读包含 Agent 自报的修改摘要与 test succeeded；没有独立 CI run、commit、ProjectFact 或事实 fingerprint。它只能作为 PROCESS_EVIDENCE 保留来源和待验证状态。",
      "expectedProjectShapes": ["AGENT_RESULT_MATERIAL"],
      "mustFindEvidence": ["source:agent-result"],
      "mustNotClaim": ["confirmed ProjectFact", "stable capability completed"],
      "expectedTools": ["AGENT_RESULT"],
      "forbiddenTools": ["SCIP"],
      "expectedViews": ["PROCESS_EVIDENCE"],
      "forbiddenViews": ["CONFIRMED_FACT"],
      "expectedUnknowns": ["independent verification"],
      "expectedConflicts": [],
      "expectedHistoryMode": "AGENT_ONLY",
      "expectedDeepReadTargets": ["source:agent-result"]
    },
    {
      "id": "token-usage",
      "source": "fixture://token-usage",
      "important": true,
      "context": "source:usage 只包含 token=5200、latency=2s、model=request metadata，没有项目成果证据。",
      "expectedProjectShapes": ["PROCESS_METADATA"],
      "mustFindEvidence": ["source:usage"],
      "mustNotClaim": ["project completed", "high quality", "mature capability"],
      "expectedTools": [],
      "forbiddenTools": ["DOC_READER", "SCIP", "GIT_HISTORY"],
      "expectedViews": ["PROCESS_METADATA"],
      "forbiddenViews": ["CAPABILITIES", "MATURITY"],
      "expectedUnknowns": ["actual project result"],
      "expectedConflicts": [],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": []
    },
    {
      "id": "projectflow-itself",
      "source": "repository://ProjectFlow@v3.7.1",
      "important": true,
      "context": "source:context 标明当前 V3.7.1 Adaptive Execution；source:old-roadmap 的 Automatic Memory Maintenance 是历史路线；V3.8 仅是未来阶段。",
      "toolEvidence": "source:context 深读描述当前 Discover→Scout→Plan→Execute→Validate→conditional synthesis；source:architecture 说明 Java backend、Next.js frontend 和事实/派生层边界；source:old-roadmap 的 Automatic Memory Maintenance next 是历史表述，V3.8 仍未发生。",
      "expectedProjectShapes": ["BACKEND", "FRONTEND", "DEVELOPER_WORKBENCH"],
      "mustFindEvidence": ["source:context", "source:architecture", "source:old-roadmap"],
      "mustNotClaim": ["V3.8 complete", "Automatic Memory Maintenance is next stage"],
      "expectedTools": ["DOC_READER", "MANIFEST", "GIT_HISTORY", "GIT_TAG"],
      "forbiddenTools": [],
      "expectedViews": ["CURRENT_STATE", "ARCHITECTURE", "HISTORICAL_COVERAGE"],
      "forbiddenViews": ["V3_8_COMPLETE"],
      "expectedUnknowns": ["future V3.8 outcome"],
      "expectedConflicts": ["HISTORICAL_ROADMAP_CURRENTNESS"],
      "expectedHistoryMode": "MILESTONE_WINDOWS",
      "expectedDeepReadTargets": ["source:context", "source:architecture"]
