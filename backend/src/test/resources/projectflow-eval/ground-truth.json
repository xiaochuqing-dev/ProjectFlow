    {
      "id": "long-git-history",
      "source": "fixture://long-git-history",
      "important": false,
      "context": "source:git-meta 显示 1200 个提交与 8 个 Tag；采样达到上限，只能筛 milestone windows，不能逐提交调用模型。",
      "expectedProjectShapes": ["CODE_PROJECT"],
      "mustFindEvidence": ["source:git-meta"],
      "mustNotClaim": ["complete reconstruction", "every commit analyzed"],
      "expectedTools": ["GIT_HISTORY", "GIT_TAG"],
