{
  "standard": "ProjectFlow V3.7.2 stage-specific human ground truth; not a universal benchmark",
  "cases": [
    {
      "id": "empty-directory",
      "source": "fixture://empty-directory",
      "important": false,
      "context": "目录为空，没有文件、Git 或历史证据。",
      "expectedProjectShapes": ["EMPTY"],
      "mustFindEvidence": [],
      "mustNotClaim": ["architecture", "timeline", "database"],
      "expectedTools": [],
      "forbiddenTools": ["DOC_READER", "GIT_HISTORY", "SCIP"],
      "expectedViews": [],
      "forbiddenViews": ["ARCHITECTURE", "TIMELINE", "EVOLUTION"],
      "expectedUnknowns": ["project purpose"],
      "expectedConflicts": [],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": []
    },
    {
      "id": "blank-text",
      "source": "fixture://blank-text",
      "important": false,
      "context": "只有一个空白文本文件，内容长度为 0。",
      "expectedProjectShapes": ["EMPTY_CONTENT"],
      "mustFindEvidence": [],
      "mustNotClaim": ["implemented capability", "architecture", "timeline"],
      "expectedTools": [],
      "forbiddenTools": ["DOC_READER", "GIT_HISTORY"],
      "expectedViews": [],
      "forbiddenViews": ["ARCHITECTURE", "TIMELINE"],
      "expectedUnknowns": ["content purpose"],
      "expectedConflicts": [],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": []
    },
    {
      "id": "strange-important-document",
      "source": "fixture://fuck-this-bug.md",
      "important": true,
      "context": "source:strange-doc 指向 fuck-this-bug.md，样本说明真实故障、约束与回滚边界，文件名奇怪但内容重要。",
      "toolEvidence": "source:strange-doc 深读正文：故障发生在批处理重试后重复写入；回滚边界是只撤销该批派生结果并保留既有事实；文档没有源码、数据库实现或独立测试状态证据。",
      "expectedProjectShapes": ["DOCUMENT"],
      "mustFindEvidence": ["source:strange-doc"],
      "mustNotClaim": ["source code architecture", "database"],
      "expectedTools": ["DOC_READER"],
      "forbiddenTools": ["SCIP", "GIT_HISTORY"],
      "expectedViews": ["DOCUMENT_OVERVIEW"],
      "forbiddenViews": ["ARCHITECTURE", "DATABASE", "TIMELINE"],
      "expectedUnknowns": ["implementation status"],
      "expectedConflicts": [],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": ["source:strange-doc"]
    },
    {
      "id": "small-script",
      "source": "fixture://small-script",
      "important": false,
      "context": "source:script 是单文件 Python CSV 转换脚本；manifest 只列 requests 依赖和命令行输入输出。",
      "expectedProjectShapes": ["SCRIPT"],
      "mustFindEvidence": ["source:script"],
      "mustNotClaim": ["multi-layer architecture", "database service", "frontend"],
      "expectedTools": ["MANIFEST"],
      "forbiddenTools": ["SCIP", "GIT_HISTORY"],
      "expectedViews": ["PURPOSE", "DEPENDENCIES", "USAGE"],
      "forbiddenViews": ["ARCHITECTURE", "TIMELINE"],
      "expectedUnknowns": ["production deployment"],
      "expectedConflicts": [],
      "expectedHistoryMode": "UNAVAILABLE",
      "expectedDeepReadTargets": []
    },
    {
